FLASK_APP=run.py
FLASK_ENV=development

SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_transfer_app

JWT_ACCESS_TOKEN_EXPIRES=3600

CORS_ORIGINS=http://localhost:5173

# Safaricom Daraja / M-Pesa. Never commit real credentials.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-public-host/api/mpesa/callback
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Integer; a missing/empty/invalid value safely falls back to 30 (never crashes boot).
DARAJA_TIMEOUT=30
# Optional defence-in-depth: comma-separated source IPs allowed to call the
# M-Pesa callback. Leave empty to allow all. The authoritative protection is
# Daraja server-side reconciliation, not this allowlist.
# DARAJA_CALLBACK_ALLOWED_IPS=

# Optional: run the test suite against PostgreSQL instead of SQLite.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vyloc_test
